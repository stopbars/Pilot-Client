<Application x:Class="BARS_Client_V2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BARS_Client_V2"
             xmlns:h="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <h:TaskbarIcon x:Key="AppTaskbarIcon"
                           IconSource="/appicon.ico"
                           ToolTipText="BARS Client"
                           MenuActivation="LeftOrRightClick"
                           PopupActivation="None"
                           Visibility="Collapsed"
                           TrayLeftMouseUp="TaskbarIcon_OnTrayLeftMouseUp">
                <h:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show"
                                  Click="TaskbarIcon_ShowMenuItem_OnClick"/>
                        <MenuItem Header="Settings"
                                  Click="TaskbarIcon_SettingsMenuItem_OnClick"/>
                        <Separator/>
                        <MenuItem Header="Exit"
                                  Click="TaskbarIcon_ExitMenuItem_OnClick"/>
                    </ContextMenu>
                </h:TaskbarIcon.ContextMenu>
            </h:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
